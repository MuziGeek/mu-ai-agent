graph TB
    subgraph 用户入口
        USER["用户输入: '关于暴力的问题'"]
    end

    subgraph ChatClient
        PROMPT["chatClient.prompt().user(message).call()"]
    end

    subgraph DefaultAroundAdvisorChain["DefaultAroundAdvisorChain（责任链调度器）<br/>内部维护 Deque&lt;CallAdvisor&gt;，按 order 排序后逐个 pop 执行"]
        NEXT1["chain.nextCall(Request_0)"]
        NEXT2["chain.nextCall(Request_1)"]
        NEXT3["chain.nextCall(Request_2)"]
        NEXT4["chain.nextCall(Request_2)"]
    end

    subgraph ADV1["① SensitiveWordAdvisor（order=0）<br/>BaseAdvisor 实现"]
        direction TB
        B1_BEFORE["before(): 检查用户输入是否包含敏感词<br/>DFA 状态机匹配 → '暴力' 命中<br/>mutate().prompt(augmentUserMessage('关于***的问题')).build()<br/>→ 返回 Request_1（新对象）"]
        B1_AFTER["after(): 透传，不修改 AI 输出<br/>return response"]
    end

    subgraph ADV2["② MessageChatMemoryAdvisor（order=0）<br/>Spring AI 内置"]
        direction TB
        B2_BEFORE["before(): 将用户消息追加到 ChatMemory<br/>滑动窗口保留最近 10 条<br/>→ 返回 Request_2（包含历史消息的新对象）"]
        B2_AFTER["after(): 将 AI 响应存入记忆"]
    end

    subgraph ADV3["③ MyLoggerAdvisor（order=0）<br/>CallAdvisor + StreamAdvisor 实现"]
        direction TB
        B3_BEFORE["before(): 记录请求日志<br/>logger.debug(request)<br/>→ 原样返回 Request_2"]
        B3_AFTER["after(): 记录响应日志<br/>logger.debug(response)"]
    end

    subgraph TERMINAL["④ ChatModelCallAdvisor（order=LOWEST_PRECEDENCE）<br/>链条终点，框架自动添加"]
        CALL_MODEL["chatModel.call(prompt)<br/>发送最终 Prompt 到 DashScope qwen-plus<br/>→ 返回 ChatClientResponse"]
    end

    subgraph 响应返回["响应沿链条反向回传"]
        RESPONSE["ChatClientResponse<br/>最终返回给用户"]
    end

    USER --> PROMPT
    PROMPT --> NEXT1
    NEXT1 --> B1_BEFORE
    B1_BEFORE --> NEXT2
    NEXT2 --> B2_BEFORE
    B2_BEFORE --> NEXT3
    NEXT3 --> B3_BEFORE
    B3_BEFORE --> NEXT4
    NEXT4 --> CALL_MODEL
    CALL_MODEL --> B3_AFTER
    B3_AFTER --> B2_AFTER
    B2_AFTER --> B1_AFTER
    B1_AFTER --> RESPONSE

    style ADV1 fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    style ADV2 fill:#e3f2fd,stroke:#2196f3,stroke-width:2px
    style ADV3 fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px
    style TERMINAL fill:#e8f5e9,stroke:#4caf50,stroke-width:2px
    style DefaultAroundAdvisorChain fill:#fafafa,stroke:#666,stroke-width:1px,stroke-dasharray:5
