<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.muzi</groupId>
    <artifactId>mu-ai-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mu-ai-agent</name>
    <description>mu-ai-agent</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!--
                Spring AI 1.1.8 BOM：锁定 spring-ai-* 框架模块版本。
                放在 alibaba BOM 之前，确保框架版本由 Spring AI BOM 管理。
                spring-ai-alibaba-starter-dashscope 1.1.2.1 依赖 Spring AI 1.1.x API。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.1.8</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>1.0.0.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.37</version>
        </dependency>

        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>4.4.0</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-memory</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.alibaba.cloud.ai</groupId>
                    <artifactId>spring-ai-alibaba-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/com.alibaba/dashscope-sdk-java -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>dashscope-sdk-java</artifactId>
            <version>2.22.17</version>
            <scope>compile</scope>
        </dependency>

        <!--
            Spring AI Alibaba DashScope 1.1.2.1：
            starter 自带 dashscope + autoconfigure，版本统一为 1.1.2.1，
            配合 spring-ai-bom 1.1.8 使用，无需额外指定 core 版本。
        -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
            <version>1.1.2.1</version>
        </dependency>
        <!--
            显式声明 1.1.2.1 覆盖 alibaba BOM 1.0.0.2 的版本管理，
            否则 BOM 会将 starter 传递的 autoconfigure-dashscope 降级到 1.0.0.2，
            导致旧版 core（DashScopeChatOptions 不兼容）和损坏的自动配置类被引入。
        -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-autoconfigure-dashscope</artifactId>
            <version>1.1.2.1</version>
        </dependency>

        <!--
            Spring AI Tika 文档解析器：支持 PDF、DOCX、HTML、TXT 等多种格式。
            Spring AI BOM 1.1.8 管理版本号。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tika-document-reader</artifactId>
        </dependency>

        <!--
            jtokkit：OpenAI BPE 分词器的 Java 实现，TokenCountBatchingStrategy 用它按 token 预算切批。
            DashScopeBatchingStrategy 直接引用其 EncodingType，属「直接使用的库应显式声明」，
            不再依赖 spring-ai-tika-document-reader → spring-ai-commons 的传递引入
            （传递依赖一旦上游调整就会被无声移除，编译期才暴露）。
            spring-ai-bom 1.1.8 未管理该版本，显式锁定为当前传递引入的 1.1.0，避免版本漂移。
        -->
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
            <version>1.1.0</version>
        </dependency>

        <!--
            Spring AI SimpleVectorStore：内存向量存储，适合开发和小规模数据。
            Spring AI BOM 1.1.8 管理版本号。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>

        <!--
            Spring AI VectorStore Advisor：提供 QuestionAnswerAdvisor，
            自动将用户查询在向量存储中检索相关文档，拼入 prompt 实现 RAG。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>

        <!--
            Spring Boot JDBC Starter：
            激活 DataSourceAutoConfiguration + JdbcTemplateAutoConfiguration，
            为 PgVectorStore 提供 DataSource 和 JdbcTemplate Bean。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
            Spring AI PgVector 向量存储 Starter：
            基于 PostgreSQL pgvector 扩展的持久化向量存储，替代内存版 SimpleVectorStore。
            版本由 spring-ai-bom 1.1.8 管理，无需显式指定。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!--
            PostgreSQL JDBC 驱动：
            spring-ai-starter-vector-store-pgvector 已传递引入，显式声明为最佳实践，
            版本由 spring-boot-starter-parent 管理。
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 
            修复 jsonschema 版本冲突：
            Spring AI 1.0.0 的 BeanOutputConverter 使用 victools jsonschema 生成 JSON Schema。
            spring-ai-alibaba-bom 将 jsonschema-generator 锁定在 4.31.1，
            但 jsonschema-module-jackson 需要 4.37.0，其中用到了 AnnotationHelper 类（4.31.1 中不存在）。
            显式声明 4.37.0 对齐版本，解决 NoClassDefFoundError。
        -->
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-generator</artifactId>
            <version>4.37.0</version>
        </dependency>

        <!-- 序列化 -->
        <dependency>
            <groupId>com.esotericsoftware</groupId>
            <artifactId>kryo</artifactId>
            <version>5.6.2</version>
        </dependency>

    </dependencies>

    <!--    仓库配置-->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <!--
                                必须显式声明版本，否则 IDEA 解析 annotationProcessorPaths 时
                                不会回溯父 POM（spring-boot-dependencies）管理的版本，
                                会把版本记成 "unknown"，并生成一个不存在的处理器路径
                                （.../lombok/unknown/lombok-unknown.jar），
                                导致注解处理器加载失败：@Slf4j 不生成 log 字段，报「找不到符号 变量 log」。
                                Maven 侧能正常解析，所以表现为「命令行编译通过、IDEA 编译报错」。
                                ${lombok.version} 由 spring-boot-dependencies 定义（如 1.18.38）。
                            -->
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
